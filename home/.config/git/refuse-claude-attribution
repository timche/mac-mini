#!/bin/sh

# pre-push, from [hook "refuse-claude-attribution"] in .gitconfig. The backstop
# for what commit-msg never sees: a commit made with --no-verify, a cherry-pick
# or a commit from another machine. Refused rather than rewritten, because a push
# cannot change the commits it is pushing.

set -u

pattern='^[[:space:]]*co-authored-by:.*(claude|anthropic\.com)|generated with \[?claude code'
zero='^0+$'
found=""

while read -r local_ref local_sha remote_ref remote_sha; do
  echo "$local_sha" | grep -qE "$zero" && continue

  if echo "$remote_sha" | grep -qE "$zero"; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  # shellcheck disable=SC2086
  for sha in $(git rev-list $range); do
    if git log -1 --format=%B "$sha" | grep -qiE "$pattern"; then
      found="$found $(git log -1 --format='%h %s' "$sha")
"
    fi
  done
done

[ -z "$found" ] && exit 0

echo "Refusing to push: these commits carry Claude attribution. Reword them" >&2
echo "(git rebase -i, or git commit --amend for the last one) and push again:" >&2
printf '%s' "$found" >&2
exit 1
