#!/bin/sh
# Runs window, which lists, captures and records one app window, and builds it first if its
# sources have changed since the binary in the cache was made. tools/window/README.md has
# what it does and why; the shared script this ends by sourcing has why it is built on the
# way past.

set -u

tool=window
cache=${WINDOW_CACHE_DIR:-}
no_binary="there is no window binary and none could be built from tools/window"

# The repository is found through this script's own resolved path rather than named, so the
# same wrapper works as the symlink in ~/.local/bin, as a file in a checkout, and in a
# worktree.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
self=$(cd "$(dirname "$self")" && pwd)/$(basename "$self")
repo=$(cd "$(dirname "$self")/../../.." && pwd)

. "$repo/home/.local/libexec/build-tool"
