#!/usr/bin/env bash
# Runs a build with Tim's Apple Developer ID certificate in its environment and
# nowhere else.
#
#   with-apple-signing bun run build:mac
#
# The certificate comes out of 1Password at the moment of the build, as the base64
# and the password electron-builder wants in CSC_LINK and CSC_KEY_PASSWORD, and it
# is never written to disk and never imported into a keychain: electron-builder
# makes a temporary keychain of its own from those two values and deletes it when
# the build ends. That is the same trade the commit-signing key already makes on
# this machine — mac-mini-setup reads the private half into an ssh-agent and writes
# only the public half — and it is why a .p12 in ~/Downloads is not the route.
#
# The references are in ~/.config/op/apple-signing.env, which holds `op://` paths
# rather than values; APPLE_SIGNING_ENV_FILE points at another file when an item or
# a field label moves. The service-account token is read from the file mac-mini-setup's
# claude/signing-key.sh stored, into the environment of `op run` alone: it is not
# exported here, and `env -u` takes it back off before the build sees it, so a
# build script cannot read the vault it was signed from.
#
# `op run` masks the resolved values in whatever the build prints, which is left
# on: electron-builder is verbose and the password would otherwise be one stray
# echo away from a terminal scrollback.

set -uo pipefail

env_file="${APPLE_SIGNING_ENV_FILE:-$HOME/.config/op/apple-signing.env}"
token_file="${OP_SERVICE_ACCOUNT_TOKEN_FILE:-$HOME/.config/op/service-account-token}"

if [ "$#" -eq 0 ] || [ "$1" = -h ] || [ "$1" = --help ]; then
  echo "usage: with-apple-signing <command> [args...]"
  echo
  echo "Runs the command with CSC_LINK and CSC_KEY_PASSWORD resolved from 1Password."
  [ "$#" -eq 0 ] && exit 2
  exit 0
fi

die() {
  printf 'with-apple-signing: %s\n' "$1" >&2
  exit 1
}

if ! command -v op >/dev/null 2>&1; then
  die "op is not installed — it is Homebrew's: brew install 1password-cli"
fi

[ -f "$env_file" ] ||
  die "no secret references at $env_file (mise bootstrap dotfiles apply installs it)"

[ -r "$token_file" ] ||
  die "no 1Password service-account token at $token_file — mac-mini-setup's claude/signing-key.sh stores one"

# electron-builder adds its temporary keychain to the login keychain's search list
# and puts the list back when it is done, so two builds overlapping can each
# restore a list the other had already changed and lose the login keychain from
# it. One signed build at a time, therefore, and the wait is announced because the
# alternative is a build that looks hung.
cache="${XDG_CACHE_HOME:-$HOME/.cache}"
[ -d "$HOME/Library/Caches" ] && cache="$HOME/Library/Caches"
lock="$cache/with-apple-signing.lock"

mkdir -p "$cache"

waiting=false

while ! mkdir "$lock" 2>/dev/null; do
  holder="$(cat "$lock/pid" 2>/dev/null)"

  # A run that was killed outright reached no trap, and its lock would otherwise
  # stop every build after it. The pid is missing only in the instant between the
  # mkdir and the write below, so a lock without one is stale once it has an age.
  if { [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; } ||
     { [ -z "$holder" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; }; then
    echo "with-apple-signing: taking over the lock left behind by ${holder:+pid }${holder:-an earlier run}" >&2
    rm -rf "$lock"
    continue
  fi

  if [ "$waiting" = false ]; then
    echo "with-apple-signing: waiting for the signed build already running${holder:+ as pid $holder}" >&2
    waiting=true
  fi

  sleep 2
done

echo $$ >"$lock/pid"

release() { rm -rf "$lock"; }
trap release EXIT
# Ctrl-C reaches the build too, and a wrapper that only trapped EXIT would still
# release the lock — but not before bash carried on to the next line.
trap 'release; exit 130' INT TERM

# electron-builder reads the provisioning profile from a file, and a project keeps
# that file out of git, so a fresh checkout or worktree has none. Written only
# where package.json's electron-builder config names one and nothing is there yet,
# inside `op run` because that is the one place the resolved value exists.
# shellcheck disable=SC2016 # expanded by the bash that op run starts, not here
place_profile='
profile="$(jq -r ".build.mac.provisioningProfile // empty" package.json 2>/dev/null)"
if [ -n "$profile" ] && [ ! -e "$profile" ] && [ -n "${APPLE_PROVISIONING_PROFILE:-}" ]; then
  printf "%s" "$APPLE_PROVISIONING_PROFILE" | base64 -d >"$profile" &&
    echo "with-apple-signing: wrote the provisioning profile to $profile" >&2
fi
exec "$@"'

# What only one app needs, such as meru's provisioning profile, is in a file named
# for its repository, taken from the origin remote rather than the directory for the
# reason project-docs.sh gives: a worktree is named for its branch.
env_files=(--env-file "$env_file")
repo="$(basename -s .git "$(git remote get-url origin 2>/dev/null)" 2>/dev/null)"
project_env="${env_file%.env}.d/$repo.env"
[ -n "$repo" ] && [ -f "$project_env" ] && env_files+=(--env-file "$project_env")

OP_SERVICE_ACCOUNT_TOKEN="$(cat "$token_file")" \
  op run "${env_files[@]}" -- \
  env -u OP_SERVICE_ACCOUNT_TOKEN bash -c "$place_profile" with-apple-signing "$@"
