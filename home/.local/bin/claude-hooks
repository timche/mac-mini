#!/bin/sh
# Builds claude-hooks, the binary every Claude Code hook on this Mac is a subcommand of,
# and execs the subcommand it was asked for. Why the Go tools here are built on the way
# past at all is in the shared script this ends by sourcing.
#
# What is claude-hooks' own is where it runs: inside a hook, on every Bash call Claude Code
# matches, with the session waiting. That is why settings.json runs the built binary and
# reaches this only when there is none — this shell, the find, the shasum and the mise cost
# several times the check itself — and why the binary is told at build time where its
# sources and this script are: it compares their times itself and execs this with the event
# still unread when they have moved, so an edit is live on the very next command.
# CLAUDE_HOOKS_FRESH says that handoff has happened, and stops a second one.
#
# Twenty seconds a step, sized on the run that reaches this script rather than the rebuild
# an edit costs: a Mac that has never built the tool compiles the module and a test binary
# per package from an empty Go cache, several seconds and over ten respectively on a machine
# a few times slower than this one, such as the three-core runner CI builds it on. Anything
# shorter kills the one build that had to work and leaves the session with no hook. What
# these catch is a step that hangs; the thirty seconds settings.json allows the Bash hook
# bounds them from outside and covers a cold run.

set -u

tool=claude-hooks
cache=${CLAUDE_HOOKS_CACHE_DIR:-}
no_binary="there is no claude-hooks binary and none could be built, so nothing is checking this command"
build_timeout=20
test_timeout=20
drain_stdin=1
wrapped_var=CLAUDE_HOOKS_FRESH

# The repository is found through this script's own resolved path rather than named, so the
# same wrapper works as the symlink in ~/.local/bin, as a file in a checkout, and in a
# worktree.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
self=$(cd "$(dirname "$self")" && pwd)/$(basename "$self")
repo=$(cd "$(dirname "$self")/../../.." && pwd)

src="$repo/tools/claude-hooks"

# Written into the binary so that it can compare its sources' times without being told
# anything at run time, since the hook hands it nothing but the event.
ldflags="-X 'main.source=$src' -X 'main.wrapper=$self'"

. "$repo/home/.local/libexec/build-tool"
