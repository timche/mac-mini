<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Symlinked into ~/Library/LaunchAgents from the [dotfiles] entry in mise.toml,
     which launchd accepts: it resolves the link when the job is bootstrapped and
     reads the file behind it.

     launchd expands neither ~ nor $HOME in a plist — a $HOME in StandardOutPath is
     an EX_CONFIG failure at load with nothing anywhere naming the key that was
     wrong — but it does hand a gui-domain agent a HOME. So the PATH and the log
     both move into a shell, which is the one thing here that can expand one, and
     this file needs no rendering to name no account. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.timche.hachiko-gc</string>
  <!-- launchd hands a job almost no PATH. ~/.local/bin first, for the hachiko
       wrapper itself and for the mise that rebuilds the binary when the sources have
       changed; Homebrew's prefix for docker and for the op CLI behind the op wrapper,
       /usr/local/bin for a docker Docker Desktop put there; the system directories
       for git, ps and lsof. exec, so this job's own process is the sweep. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"; exec "$HOME/.local/bin/hachiko" gc &gt;&gt;"$HOME/Library/Logs/hachiko-gc.log" 2&gt;&amp;1</string>
  </array>
  <!-- A sweep on load catches everything a machine lost while it was off. -->
  <key>RunAtLoad</key>
  <true/>
  <!-- The timer is the whole of the trigger, since no removal hands anything a hook.
       A WatchPaths on ~/.herdr/worktrees would catch almost nothing: it is not
       recursive, and a worktree lives two levels down at <repo>/<branch>. Ten minutes
       is long enough to be free and short enough that a compose project holding a
       port is gone before the next session wants it. -->
  <key>StartInterval</key>
  <integer>600</integer>
</dict>
</plist>
