<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Symlinked into ~/Library/LaunchAgents from the [dotfiles] entry in mise.toml,
     which launchd accepts: it resolves the link when the job is bootstrapped and
     reads the file behind it.

     launchd expands neither ~ nor $HOME in a plist — a $HOME in StandardOutPath is
     an EX_CONFIG failure at load with nothing anywhere naming the key that was
     wrong — but it does hand a gui-domain agent a HOME. So the PATH and the log
     both move into a shell, which is the one thing here that can expand one, and
     this file needs no rendering to name no account.

     A second agent rather than part of the five-minute check: a reply from Tim is
     worth seconds and not five minutes, and a process sitting in a poll has no
     business holding the lock the check needs. It writes nothing the check owns. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.timche.hachiko-listen</string>
  <!-- The same PATH the check has, and for the same reasons: the wrapper, the op
       that signs 1Password in with the service-account token, the herdr a reply is
       handed to the on-call session through, and the mise that rebuilds the binary. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"; exec "$HOME/.local/bin/hachiko" listen &gt;&gt;"$HOME/Library/Logs/hachiko-listen.log" 2&gt;&amp;1</string>
  </array>
  <!-- Unconditional, because the poll is the job: a listener that exited and stayed
       exited is a reply nobody ever reads. It exits on purpose twice over — when nothing
       is configured, and when the wrapper has built a new binary behind it — and neither
       of those is a failure, so SuccessfulExit would leave the agent stopped on both.
       The exit status is only there to say in the log which of them it was. -->
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <!-- Five minutes, which is how often an unconfigured listener re-checks whether it
       has a channel and a token yet. launchd's own default is ten seconds, which
       would be six starts a minute for as long as the feature is off.

       It is measured from one start to the next, not from the exit, so a listener that
       has been up longer than this — which a configured one always has — is restarted at
       once when it exits for a new binary. Only a replacement inside the first five
       minutes waits, for the remainder, which is why the watch gives the heartbeat ten. -->
  <key>ThrottleInterval</key>
  <integer>300</integer>
</dict>
</plist>
