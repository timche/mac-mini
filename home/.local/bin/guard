#!/bin/sh
# Runs guard, the PreToolUse hook every session's Bash calls go through, and builds it
# first if its sources have changed since the binary in the cache was made.
#
# hachiko's wrapper with guard's names, for hachiko's reasons: there is nowhere to release
# to, so this builds from the checkout's working tree; a tree that does not build, or whose
# tests do not pass, leaves the last binary that did in place and logs one line; and the
# binary it execs depends on nothing — not mise, not Homebrew, not a runtime — which is why
# the guard is a binary at all. The hook it replaced was Python, and a Python that a mise
# or a Homebrew upgrade moved is a guard that is off with nothing in a session saying so.
#
# What guard has that hachiko does not is where it runs: inside a hook, on every Bash call
# Claude Code matches, with the session waiting. So the numbers are the hook's. Each step
# gets ten seconds, five times the longest cold run measured and the two together well
# inside the thirty seconds settings.json allows the hook, and the sources are hashed with
# find and shasum before mise is reached for at all, which is what keeps a call with
# nothing to build in the milliseconds.
#
# Exiting 1 and never 2, in every way this can fail: 2 is how a PreToolUse hook blocks the
# command, so a guard that has no binary would otherwise refuse every command it was
# matched against. 1 is a hook error, which Claude Code reports and acts on nothing.

set -u

say() {
  printf '%s guard: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1" >&2
}

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
self=$(cd "$(dirname "$self")" && pwd)/$(basename "$self")

bindir=$(dirname "$self")
repo=$(cd "$bindir/../../.." && pwd)
src="$repo/guard"

cache="${GUARD_CACHE_DIR:-$HOME/Library/Caches/guard}"
bin="$cache/guard"
stamp="$cache/source.sha256"

build_timeout=10
test_timeout=10

run_binary() {
  if [ ! -x "$bin" ]; then
    # The event is read and dropped, so Claude Code's write to a hook that is not going to
    # answer completes rather than breaking its pipe.
    cat >/dev/null 2>&1 || :
    say "there is no guard binary and none could be built, so nothing is checking this command"
    exit 1
  fi
  exec "$bin" "$@"
}

# A checkout with no guard/ in it is a pull that moved or removed the sources, not a source
# tree to build: say so and keep checking with the binary that is already here.
if [ ! -d "$src" ]; then
  say "$src is not there, so guard was not rebuilt"
  run_binary "$@"
fi

# The sources' contents and their names, so a rename or a deletion counts as a change too.
hash=$(
  find "$src" -type f \( -name '*.go' -o -name go.mod -o -name go.sum \) 2>/dev/null |
    sort | xargs shasum -a 256 2>/dev/null | shasum -a 256 | cut -d' ' -f1
)

# One step of the rebuild, with a deadline and its output in a file. The sleeper is the
# watchdog; killing it once the step has finished is what keeps this from waiting for it.
bounded() {
  limit=$1
  log=$2
  shift 2

  "$@" >"$log" 2>&1 &
  step_pid=$!

  # The watchdog waits on its own sleep rather than being the sleep, so that killing it
  # once the step is done takes the sleep with it: a signal to the subshell does not reach
  # a child it is only waiting on, and every rebuild would leave one behind.
  (
    sleeper=
    trap '[ -n "${sleeper:-}" ] && kill "$sleeper" 2>/dev/null; exit 0' TERM
    sleep "$limit" &
    sleeper=$!
    wait "$sleeper" && kill -TERM "$step_pid" 2>/dev/null
  ) &
  watchdog_pid=$!

  wait "$step_pid"
  status=$?

  kill -TERM "$watchdog_pid" 2>/dev/null
  wait "$watchdog_pid" 2>/dev/null

  return "$status"
}

if [ -n "$hash" ] && [ "$hash" != "$(cat "$stamp" 2>/dev/null)" ]; then
  mise=$(command -v mise 2>/dev/null) || mise="$HOME/.local/bin/mise"

  # A hook is the wrong place to download a toolchain, mise's or Go's own: a go that is
  # missing or too old is install.sh's to put there.
  MISE_EXEC_AUTO_INSTALL=0
  MISE_NOT_FOUND_AUTO_INSTALL=0
  GOTOOLCHAIN=local
  export MISE_EXEC_AUTO_INSTALL MISE_NOT_FOUND_AUTO_INSTALL GOTOOLCHAIN

  CGO_ENABLED=0
  export CGO_ENABLED

  out="$cache/build.log"

  if [ ! -x "$mise" ]; then
    say "mise is missing, so guard could not be rebuilt from $src"
  # Its own complaint silenced, so what a session sees from a hook is the one line below.
  elif ! mkdir -p "$cache" 2>/dev/null; then
    say "$cache could not be made, so guard could not be rebuilt from $src"
  # -C, because a hook runs in whatever directory the session is in and mise decides what
  # is active from the directory it is asked about.
  elif ! "$mise" which -C "$repo" go >/dev/null 2>&1; then
    say "the go this repo's mise.toml asks for is not installed, so guard could not be rebuilt — run install.sh"
  elif ! bounded "$build_timeout" "$out" \
    "$mise" exec -C "$repo" -- go build -C "$src" -o "$cache/guard.$$" .; then
    rm -f "$cache/guard.$$"
    # The hash is deliberately not recorded, so the next call tries the build again.
    say "the sources in $src do not build, so this is the last binary that did: $(head -1 "$out" 2>/dev/null)"
  # Between the build and the move, so a binary that compiles but does not work never
  # reaches a session. What it decides is which commands every session on this Mac may
  # run, and the cases in these tests are the whole of that decision.
  elif ! bounded "$test_timeout" "$out" \
    "$mise" exec -C "$repo" -- go test -C "$src" ./...; then
    rm -f "$cache/guard.$$"
    # The hash is not recorded here either, for the same reason.
    say "the tests in $src do not pass, so this is the last binary whose did: $(grep -m 1 -E '^(---|FAIL|panic)' "$out" 2>/dev/null)"
  else
    # Into place in one step, so a call that starts mid-build execs a whole binary.
    mv -f "$cache/guard.$$" "$bin" && printf '%s\n' "$hash" >"$stamp"
    rm -f "$out"
  fi
fi

run_binary "$@"
