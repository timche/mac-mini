<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The one proxy every dev server on this Mac routes through, as the account
     rather than as root. A root proxy would run the node and the portless that
     mise keeps under this account's own directory, so anything running as the
     account could rewrite that JavaScript and have it executed as root — and the
     only thing root bought was binding 127.0.0.1:443, which nothing off this Mac
     reaches anyway. Tailscale Serve hands the tailnet's 443 to the unprivileged
     port instead, so the MacBook's URLs are unchanged.

     zsh rather than the /bin/sh the other agents use, because .zshenv is where
     PORTLESS_PORT and PORTLESS_TLD are, and zsh reads it for every invocation
     however it was started. That keeps the port in one file: portless takes both
     from the environment, so this plist names neither, and launchd hands the job
     the HOME the rest of it expands from. A port above 1024 is also what keeps
     portless from re-execing itself under a sudo no session can answer. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.timche.portless</string>
  <!-- mise's shim rather than the versioned install path behind it: the shim is
       a fixed path that survives a `mise up` of node or of portless, which is
       exactly what used to leave the root daemon pointing at a file that was
       gone. --foreground so launchd watches the proxy rather than a parent that
       forked it, and --skip-trust because trusting the CA is install.sh's, once,
       where a terminal or Screen Sharing can answer for it. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>exec "$HOME/.local/share/mise/shims/portless" proxy start --foreground --https --skip-trust >>"$HOME/Library/Logs/portless-proxy.log" 2>&amp;1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Unconditional, as herdr's is: portless starts a proxy of its own the first
       time a dev server finds none, so a proxy that stayed stopped would be
       replaced by one launchd does not own and Tailscale Serve does not point
       at. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- It carries every dev server's traffic, which launchd would otherwise pace
       as background work. -->
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
