# The secret references `with-apple-signing` hands to `op run`. Nothing here is a
# secret: the values are resolved into one process's environment and exist nowhere
# else, which is the whole point of signing this way rather than importing the
# .p12 into a keychain.
#
# electron-builder reads these two names, builds a temporary keychain from
# CSC_LINK and deletes it again when the build ends. CSC_LINK takes base64 as
# readily as a path, so the certificate never has to be a file.
#
# Quoted because the vault name has a space in it. `op run` strips the quotes and
# keeps the spaces; double quotes rather than single because these values hold no
# `$` for it to expand.
CSC_LINK="op://Development/Apple Developer ID Application Certificate/base64"
CSC_KEY_PASSWORD="op://Development/Apple Developer ID Application Certificate/password"


# The Developer ID team, which is public — every signed app carries it — so a value
# rather than a reference. Notarisation wants it, and meru's beforePack hook only
# adds the keychain entitlement Touch ID needs when it is set.
APPLE_TEAM_ID="SUR5MVXA4C"

# Notarisation: electron-builder notarises a signed macOS build when these are set,
# which is what makes a downloaded build open without Gatekeeper's warning. The
# Apple ID and its app-specific password are one login, so one 1Password item; the
# team ID sits with the certificate, whose team it is.
APPLE_ID="op://Development/Apple App Specific Password/apple id"
APPLE_APP_SPECIFIC_PASSWORD="op://Development/Apple App Specific Password/password"
