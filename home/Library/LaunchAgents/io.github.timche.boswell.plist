<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Symlinked into ~/Library/LaunchAgents from the [dotfiles] entry in mise.toml,
     which launchd accepts: it resolves the link when the job is bootstrapped and
     reads the file behind it.

     launchd expands neither ~ nor $HOME in a plist — a $HOME in StandardOutPath is
     an EX_CONFIG failure at load, with nothing anywhere naming the key that was
     wrong — but it does hand a gui-domain agent a HOME. So the PATH, the socket
     and the log all move into a shell, which is the one thing here that can expand
     one, and this file needs no rendering to name no account. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.timche.boswell</string>
  <!-- Homebrew's boswell, like every other CLI tool on this machine, spelled out
       because launchd hands a job almost no PATH at all.

       The PATH the shell exports is for boswell's children: git's credential
       helper is gh, and boswell asks gh for a token when it files an issue. The
       socket is the ssh-agent claude/ssh-agent.sh keeps the signing key in — boswell's own
       commits are signed, and the SSH_AUTH_SOCK launchd hands out holds nothing.
       exec, so the exit status launchd sees is boswell's rather than sh's and
       KeepAlive below still reads it. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>export PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin"; export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"; exec /opt/homebrew/bin/boswell >>"$HOME/Library/Logs/boswell.log" 2>&amp;1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- boswell exits rather than running blind when a watcher dies, so something
       has to bring it back; SuccessfulExit keeps launchd from restarting one that
       was asked to stop. launchd has no equivalent of the unit's start limit, so a
       boswell that fails every start retries for as long as the Mac is up, and the
       log is the only place that shows. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <!-- Long enough that a boswell failing on every start paces itself rather than
       spinning. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
