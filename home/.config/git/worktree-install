#!/bin/sh

# post-checkout, from [hook "worktree-install"] in .gitconfig. A JS project's new
# worktree starts with no node_modules, and a lefthook or husky pre-commit that
# looks for itself there exits successfully having linted nothing — so the
# install is a mechanism rather than something a session has to remember.

set -u

prev="${1-}"

# git worktree add is the only checkout this acts on: a previous HEAD of nothing
# (SHA-1 or SHA-256 length) in a repository whose git dir is not the common one.
# A clone reports the same null HEAD from the main worktree, and installing there
# would run the lifecycle scripts of a repository nobody has read yet.
[ -n "$prev" ] || exit 0
case "$prev" in
  *[!0]*) exit 0 ;;
esac
case "${#prev}" in
  40 | 64) ;;
  *) exit 0 ;;
esac

git_dir="$(cd "$(git rev-parse --absolute-git-dir 2>/dev/null)" 2>/dev/null && pwd -P)" || exit 0
common_dir="$(cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P)" || exit 0
[ "$git_dir" != "$common_dir" ] || exit 0

worktree="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -f "$worktree/package.json" ] || exit 0
[ ! -e "$worktree/node_modules" ] || exit 0

# The main worktree having node_modules is what says the project has already been
# installed by hand, and so trusted once, by whoever cloned it.
main="$(git worktree list --porcelain | sed -n 's/^worktree //p' | head -1)"
[ -n "$main" ] && [ -d "$main/node_modules" ] || exit 0

if [ -f "$worktree/bun.lock" ] || [ -f "$worktree/bun.lockb" ]; then
  set -- bun install --frozen-lockfile
elif [ -f "$worktree/pnpm-lock.yaml" ]; then
  set -- pnpm install --frozen-lockfile
elif [ -f "$worktree/package-lock.json" ]; then
  set -- npm ci
elif [ -f "$worktree/yarn.lock" ]; then
  set -- yarn install --immutable
else
  exit 0
fi

# Nothing trusts a mise config here: mise shares trust across a repository's
# worktrees, so a linked one inherits the main checkout's, and a config that is
# only [tools] with plain versions needs none at all.
echo "Installing dependencies in this worktree: $*" >&2

if ! (cd "$worktree" && "$@" >&2); then
  echo "Dependencies were not installed. Run it by hand: cd \"$worktree\" && $*" >&2
fi

# Never the checkout's failure: the worktree exists either way, and git would
# otherwise report the add itself as having gone wrong.
exit 0
