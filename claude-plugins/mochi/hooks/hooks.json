{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^AskUserQuestion$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$MOCHI_THREAD\" ] || \"$HOME/Library/Caches/mochi/mochi\" session-event ask >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$MOCHI_THREAD\" ] || \"$HOME/Library/Caches/mochi/mochi\" session-event stop >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^AskUserQuestion$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$MOCHI_THREAD\" ] || \"$HOME/Library/Caches/mochi/mochi\" session-event heard >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$MOCHI_THREAD\" ] || \"$HOME/Library/Caches/mochi/mochi\" session-event heard >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
