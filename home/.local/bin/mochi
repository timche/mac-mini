#!/bin/sh
# Runs mochi, Tim's Claude Tag for Discord, and builds it first if its sources have changed
# since the binary in the cache was made. Why the Go tools here are built on the way past
# at all is in the shared script this ends by sourcing.
#
# What is mochi's own: the sources, which are not in this repository. mochi is
# repeekgg/mochi, and this wrapper is all of it the Mac keeps — so that the arrangement
# every compiled tool here runs under covers mochi too, and a pull in mochi's checkout is
# the whole of its deploy. The binary works out its configuration, its token's reference
# and its briefing from that checkout for itself, so nothing is handed to it here.

set -u

tool=mochi
cache=${MOCHI_CACHE_DIR:-}
no_binary="there is no mochi binary and none could be built, so nothing is listening to Discord"

# The repository is found through this script's own resolved path rather than named, so the
# same wrapper works as the symlink in ~/.local/bin, as a file in a checkout, and in a
# worktree.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
self=$(cd "$(dirname "$self")" && pwd)/$(basename "$self")
repo=$(cd "$(dirname "$self")/../../.." && pwd)

# mochi's checkout, which is where the sources are and where the build and its gate run.
# A clone that is not there is the shared script's case for a tool whose sources have
# moved: it says so and keeps running the binary the cache already has.
src="${MOCHI_SRC:-$HOME/projects/repeekgg/mochi}"

. "$repo/home/.local/libexec/build-tool"
