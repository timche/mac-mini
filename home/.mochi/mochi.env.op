# mochi's bot, a Discord application of its own rather than hachiko's: hachiko's is the
# admin bot in the private incident server, and this one sits in servers other people
# moderate. Beside the wrapper that reads it, resolved by `op run --env-file` once per
# listener start and once per `mochi post` or `mochi history`, each a read against the
# service account's daily limit.
MOCHI_DISCORD_BOT_TOKEN=op://dev/mochi-discord/bot token
