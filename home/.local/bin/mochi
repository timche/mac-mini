#!/bin/sh
# Runs mochi, Tim's Claude Tag for Discord, and builds it first if its sources have changed
# since the binary in the cache was made. Why the Go tools here are built on the way past
# at all is in the shared script this ends by sourcing.
#
# What is mochi's own: the Discord client in tools/lib/discord/, a module of this checkout
# that mochi's go.mod replaces with that folder. Its sources are hashed with mochi's, so an
# edit to either is a rebuild, and its tests are part of the gate — named by module, which
# is how a go command in mochi reaches the folder its go.mod replaces the module with.
# Beside that, the token's reference and the standing orders every session it starts opens
# on, both of which come from the checkout this wrapper runs from.

set -u

tool=mochi
cache=${MOCHI_CACHE_DIR:-}
no_binary="there is no mochi binary and none could be built, so nothing is listening to Discord"

# The repository is found through this script's own resolved path rather than named, so the
# same wrapper works as the symlink in ~/.local/bin, as a file in a checkout, and in a
# worktree.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
self=$(cd "$(dirname "$self")" && pwd)/$(basename "$self")
repo=$(cd "$(dirname "$self")/../../.." && pwd)

hashed="$repo/tools/mochi $repo/tools/lib/discord"
test_packages="./... github.com/timche/mac-mini/discord/..."

# In mochi's own folder, which is where mise links it, so the token has a reference to
# resolve without the binary in the cache knowing where the checkout is.
MOCHI_ENV_FILE="${MOCHI_ENV_FILE:-$HOME/.mochi/mochi.env.op}"
export MOCHI_ENV_FILE

# The standing orders every session mochi starts opens on, from the plugin in the checkout
# this wrapper runs from rather than wherever the binary in the cache was built.
MOCHI_BRIEFING="${MOCHI_BRIEFING:-$repo/account/claude-plugins/mochi/briefing.md}"
export MOCHI_BRIEFING

. "$repo/home/.local/libexec/build-tool"
