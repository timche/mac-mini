{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(~/.config/op/service-account-token)",
      "Edit(~/.config/op/service-account-token)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/strip-claude-attribution.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/kill-by-pid.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|Edit|MultiEdit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$HACHIKO_ONCALL_SESSION\" ] || python3 \"$HOME/.claude/hooks/oncall-guard.py\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-tab-name.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/project-docs.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/worktree-info.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-tab-reset.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.local/share/mise/shims/ccstatusline\"",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "mochi@mac-mini": false
  },
  "extraKnownMarketplaces": {
    "mac-mini": {
      "source": {
        "source": "directory",
        "path": "~/.mac-mini/claude-plugins"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "low"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
