.DS_Store
# Claude Code's worktrees of this repository, which boswell would otherwise commit
# within seconds as an embedded repository.
.claude/worktrees/
# Synced onto every machine from the claude.ai account, so there is nothing to
# version, and the folder name carries the account's organisation id.
home/.claude/skills/synced/
# Claude Code's own settings for this checkout, which are this Mac's rather than
# the repository's; the tracked half is home/.claude/settings.json.
/.claude/settings.local.json
# What a session writes to show a change working. It is attached to a pull request
# or copied off, and boswell would otherwise publish every frame of it.
*.png
*.mov
*.mp4
# This repository is public and holds no secret: every one of them is an op://
# reference resolved at the moment it is needed. Nothing in either shape lands
# here by accident.
*.pem
.env
.env.*
# shibuya's is the one exception, named for what `op run --env-file` reads: it holds two
# op:// references and nothing else, which test/assert.sh reads back. Exempted by its one
# path rather than by its name, so a `.env` anywhere here is still ignored.
!/shibuya/.env.op
# A JS project's dependencies, and wrangler's local state and build output.
node_modules/
.wrangler/
