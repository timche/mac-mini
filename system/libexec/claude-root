#!/bin/bash

# The one command a Claude Code session on this Mac may run under sudo without
# Tim. Everything else privileged is still a command printed for him to read and
# run himself, because sudo here asks for his password and a session has no
# terminal to type it at.
#
# It exists for the class of incident where the fix is one root command and the
# wait is hours: a scheduler daemon that got into a loop and spun a core all
# night, which `killall dasd` ends in a second and which neither a sleeping Tim
# nor an on-call session could touch. Blanket sudo would have fixed that one too,
# and every other thing a session could ever decide to do; this takes a fixed set
# of actions and refuses the rest, so what a session is trusted with is a list
# somebody can read rather than the whole machine.
#
# Two rules decide what may be an action here, and the second is the one that is
# easy to get wrong.
#
# No action takes a path, a command, a signal or a pid from the caller. The only
# argument any of them takes is a name matched against a list compiled in below,
# by string equality and never as a pattern, and a name that is not on it is
# refused before anything privileged runs. Adding to that list is an edit to this
# file, which lands as a root-owned copy through root-helper.sh and so needs Tim's
# password — which is the point.
#
# A name an action needs but a caller may not choose is worked out here instead, as
# root, from what the system itself says: install-apple-updates reads the labels it
# installs out of softwareupdate's own listing rather than being handed them. Which
# is the same rule from the other side — nothing a caller says decides what root
# does.
#
# And no action touches a path the account can write, even one this file spells
# out itself. A root command aimed at a file in a home directory is a root command
# the account aims wherever it likes: it replaces the file with a symlink and the
# copy writes through it, or the chown hands it a root-owned file, or the truncate
# empties whatever the link points at. That is how a log-capping action here turned
# into passwordless sudo for everything, and why there is no longer one — capping
# the account's own logs needs no root at all, so it belongs in something that runs
# as the account. An action that needs root needs it for a path only root can
# write, and assert-machine.sh reads this file to say so.
#
# reinstall-portless is the one named exception to that second rule, and nothing
# else here may follow it. portless's root daemon already runs the account's own
# node and the account's own JavaScript as root, which is portless's design rather
# than this repository's choice, so reinstalling it opens no route that is not open
# already; what it buys is that a `mise up` which moves node or portless does not
# leave every dev server on this Mac without a proxy until Tim is awake.
# assert-machine.sh reads the rule off every other action and that one function
# apart.
#
# Installed as a copy at /usr/local/libexec/claude-root, which is the path the
# sudoers rule names, by root-helper.sh.

# No -e. An action here has a result worth reporting — an old pid and a new one,
# which half of a flush failed — and an exit on the first non-zero would report
# none of it.
set -uo pipefail

# Named rather than inherited, so that the commands below are the system's
# wherever this was started from: sudo here sets no secure_path, and the calling
# account's PATH leads with directories full of version-managed shims.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

# One entry per daemon: the name a caller types, then the launchd label it stands
# for. To allow another, add a line here and re-run root-helper.sh.
#
# Homebrew owns tailscale's label and has renamed it once already, so a rename
# there is an edit here — the alternative, reading the label back from `brew
# services`, would take the name out of this list and put it in a prefix the
# account writes. Restarting it drops every tailnet connection, the SSH session a
# person would be typing in among them, which is why the nightly update is what
# calls it and a session should not.
allowed_daemons=(
  "dasd com.apple.dasd"
  "tailscale sh.brew.tailscale"
)

# The TLDs portless serves, which are PORTLESS_TLD in home/.zshenv. Spelled here
# rather than read from the account's environment, so what root is asked to serve
# is in the file Tim installs; assert-machine.sh fails when the two lists differ.
portless_tlds=(localhost timche.dev)

# How long each softwareupdate call is given. It is a network client with no
# deadline of its own, and the nightly update that waits on this holds a lock while
# it does. The bound is here rather than left to the caller because a caller's own
# timeout kills the sudo and not what sudo started, which would leave softwareupdate
# running as root with nobody waiting for it.
apple_list_seconds=240
apple_install_seconds=3600

argv="$*"
dry_run=false
[ "${CLAUDE_ROOT_DRY_RUN:-}" = 1 ] && dry_run=true

refuse() {
  echo "claude-root: $1" >&2
  echo "claude-root --list says what it allows. Anything else is a command for" >&2
  echo "Tim to run." >&2
  exit 64
}

# The actions themselves need root; the validation above does not, and neither
# does --list. Separated so that the argument handling can be tested as the
# account, with no sudo anywhere near it.
require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "claude-root: $1 needs root. Run:" >&2
    echo "  sudo /usr/local/libexec/claude-root $argv" >&2
    exit 77
  fi
}

# One line in the system log for each run that actually does something, written
# after the action and its argument have been validated. sudoers asks sudo to log
# an allowed run of this command and sudo records nothing on this Mac — neither
# /var/log/system.log nor the unified log has the entry — so this is the only
# trace a run leaves. It is a record and not evidence: logger is open to every
# process, so the account can write the same line.
log_action() {
  logger -t claude-root "$*"
}

# One command with a deadline, macOS shipping no `timeout`: the command as a child,
# and a second child that signals it when the time is up. Its stdin is /dev/null, so
# a command that decides to ask for a password fails on the spot rather than waiting
# for one nobody is there to type.
#
# Job control for the child alone, which is what puts it in a process group of its
# own: the signal then reaches whatever it started as well, and a grandchild left
# behind holding the output is a caller reading this through a command substitution
# that waits for it however long the deadline was for. The watchdog's own output goes
# nowhere for the same reason, and it is waited for after it is signalled so that
# bash has nothing left to report about it.
bounded() {
  local seconds="$1" pid watchdog waited=0 status
  shift

  set -m
  "$@" </dev/null &
  pid=$!
  set +m

  (
    while [ "$waited" -lt "$seconds" ]; do
      sleep 1
      waited=$((waited + 1))
    done
    kill -TERM -"$pid" 2>/dev/null
  ) >/dev/null 2>&1 &
  watchdog=$!

  wait "$pid"
  status=$?

  kill -TERM "$watchdog" 2>/dev/null
  wait "$watchdog" 2>/dev/null

  # 143 is the watchdog's SIGTERM, which is the one failure here worth naming: the
  # rest of what went wrong the command has said for itself.
  if [ "$status" -eq 143 ]; then
    echo "claude-root: $1 ran for more than ${seconds}s and was stopped." >&2
  fi

  return "$status"
}

daemon_label() {
  local entry

  for entry in "${allowed_daemons[@]}"; do
    if [ "${entry%% *}" = "$1" ]; then
      echo "${entry#* }"
      return 0
    fi
  done

  return 1
}

# launchd prints the running pid one tab in under the job's own dict, and prints
# further `pid =` lines inside the nested sections further down. The first match
# is the job's, which is why this stops at it.
daemon_pid() {
  launchctl print "system/$1" 2>/dev/null |
    sed -n '/^[[:space:]]*pid = /{s/.*= *//;p;q;}'
}

list() {
  local entry

  echo "claude-root — the only command a session on this Mac runs under sudo."
  echo
  echo "Actions:"
  echo "  restart-daemon <name>  restart one of the daemons below"
  echo "  flush-dns              flush the DNS cache and signal mDNSResponder"
  echo "  reinstall-portless     install portless's proxy daemon again, on the"
  echo "                         node and portless the account has now"
  echo "  install-apple-updates  install the Apple updates that are waiting, need"
  echo "                         no restart and are not macOS itself"
  echo "  --list                 this"
  echo
  echo "Daemons:"
  for entry in "${allowed_daemons[@]}"; do
    printf '  %-12s %s\n' "${entry%% *}" "${entry#* }"
  done
  echo
  echo "Proxy TLDs: ${portless_tlds[*]}"
  echo
  echo "Anything else is refused. To add a daemon, edit"
  echo "system/libexec/claude-root in the mac-mini checkout and re-run"
  echo "root-helper.sh, which is Tim's password."
}

restart_daemon() {
  local name="$1" label old new current waited refusal

  if ! label="$(daemon_label "$name")"; then
    refuse "not an allowed daemon: $name"
  fi

  old="$(daemon_pid "$label")"

  if [ "$dry_run" = true ]; then
    echo "dry run: would restart system/$label (pid ${old:-none})"
    return 0
  fi

  require_root "restart-daemon"
  log_action "restart-daemon $name"

  if [ -z "$old" ]; then
    echo "claude-root: system/$label is not running, so there is nothing to" >&2
    echo "restart." >&2
    return 69
  fi

  # `kickstart -k` is the whole of it where launchd allows it. Some of Apple's own
  # daemons are protected from being told to restart and launchctl says so rather
  # than doing half the job, so the fallback is to kill the process launchd is
  # watching and let launchd bring it back — the same outcome by the only route
  # left. SIGTERM rather than SIGKILL: a scheduler in a loop still has state worth
  # flushing, and launchd respawns it either way.
  if ! refusal="$(launchctl kickstart -k "system/$label" 2>&1)"; then
    echo "launchctl would not kickstart system/$label: ${refusal:-no reason given}"

    # Read back rather than killing the pid from a moment ago: a pid is reused,
    # and one that has moved since means the daemon restarted anyway and this has
    # nothing left to do.
    current="$(daemon_pid "$label")"

    if [ "$current" = "$old" ]; then
      echo "Killing pid $old instead; launchd respawns it."
      kill -TERM "$old" 2>/dev/null || true
    fi
  fi

  # The new pid is what says it worked, rather than the exit status of either
  # route above: launchd respawns on its own schedule and a kickstart that
  # returned 0 has only queued the work.
  waited=0
  new="$old"

  while [ "$waited" -lt 50 ]; do
    new="$(daemon_pid "$label")"
    if [ -n "$new" ] && [ "$new" != "$old" ]; then
      break
    fi
    sleep 0.1
    waited=$((waited + 1))
  done

  if [ -n "$new" ] && [ "$new" != "$old" ]; then
    echo "restarted $label: pid $old is now $new"
    return 0
  fi

  echo "claude-root: $label has not come back with a new pid in five seconds;" >&2
  echo "it is still pid ${new:-none}." >&2
  return 69
}

flush_dns() {
  local status=0

  if [ "$dry_run" = true ]; then
    echo "dry run: would flush the DNS cache and signal mDNSResponder"
    return 0
  fi

  require_root "flush-dns"
  log_action flush-dns

  dscacheutil -flushcache || status=1

  # mDNSResponder is the resolver itself and macOS keeps it running, so one that
  # is not there to signal is worth saying rather than ignoring.
  killall -HUP mDNSResponder || status=1

  if [ "$status" -eq 0 ]; then
    echo "flushed the DNS cache and signalled mDNSResponder"
  else
    echo "claude-root: the DNS flush did not fully succeed." >&2
  fi

  return "$status"
}

reinstall_portless() {
  local user home node where cli tld
  local args=()

  for tld in "${portless_tlds[@]}"; do
    args+=(--tld "$tld")
  done

  if [ "$dry_run" = true ]; then
    echo "dry run: would install portless's proxy daemon again, with the" \
         "account's own node and portless, serving ${args[*]}"
    return 0
  fi

  require_root "reinstall-portless"
  log_action reinstall-portless

  # The account the Mac logs itself in as, read off the console rather than taken
  # from the caller's environment, so what this installs is the proxy for the
  # account whose dev servers it serves and not for whoever happened to call.
  user="$(stat -f %Su /dev/console)"

  if [ -z "$user" ] || [ "$user" = root ]; then
    echo "claude-root: nobody is logged in at the console, so there is no" >&2
    echo "account whose portless this would be." >&2
    return 69
  fi

  # Asked of the account's own login shell, as the account, which is how
  # install.sh asks it for the same kind of answer: mise decides which node and
  # which portless are current, and a path written down here would be whichever
  # version was current the day it was written. The last line of each, so that a
  # profile with something to say does not become a path.
  # shellcheck disable=SC2016 # the account's shell expands it, not this one
  home="$(su -l "$user" -c 'printf "%s\n" "$HOME"' 2>/dev/null | tail -n 1)"
  node="$(su -l "$user" -c 'mise which node' 2>/dev/null | tail -n 1)"
  where="$(su -l "$user" -c 'mise where npm:portless' 2>/dev/null | tail -n 1)"

  # The CLI file the package's own bin names, rather than what `mise which`
  # answers: that is mise's shim, or under mise's aube installs a shell script
  # in .bin, neither of which node can run, and a shim run as root resolves
  # against root's own mise.
  cli=""
  if [ -x "$node" ] && [ -f "$where/node_modules/portless/package.json" ]; then
    # shellcheck disable=SC2016 # node's template literal, not a shell expansion
    cli="$("$node" -e '
      const dir = process.argv[1], pkg = require(`${dir}/package.json`);
      const bin = typeof pkg.bin === "string" ? pkg.bin : pkg.bin && pkg.bin.portless;
      if (bin) console.log(require("path").resolve(dir, bin));
    ' "$where/node_modules/portless" 2>/dev/null)"
  fi

  if [ ! -d "$home" ] || [ ! -x "$node" ] || [ -z "$cli" ] || [ ! -f "$cli" ]; then
    echo "claude-root: $user's mise does not have both node and portless, so" >&2
    echo "there is nothing to install the proxy from." >&2
    return 69
  fi

  # node and the CLI file rather than the .bin link, whose shebang wants a node
  # on PATH that this PATH deliberately does not have. HOME is the account's,
  # since portless keeps its state, its CA and its routes under it and the
  # clients read them there.
  if ! env HOME="$home" "$node" "$cli" service install "${args[@]}"; then
    echo "claude-root: portless would not install its daemon." >&2
    return 69
  fi

  echo "installed portless's proxy daemon for $user, serving ${args[*]}"
}

# What softwareupdate has waiting that this Mac may install while nobody is at it,
# one `label<tab>title<tab>version` line each. The label is what --install takes and
# is read out of the listing rather than from a caller; the other two are what a
# person recognises.
#
# Two kinds are left out of it. A macOS update asks for a volume owner's password
# even when it is root asking, Apple silicon offering no way round that without an
# MDM, so it is Tim's to install at an hour he picks. And an update with an Action is
# one that restarts or shuts the Mac down, which ends every session running on it —
# his as well, and the reason nothing here passes --restart.
apple_installable() {
  local listing

  listing="$(bounded "$apple_list_seconds" softwareupdate --list)" || return 1

  # One record is a `* Label:` line and the indented `Title:` line under it, so the
  # label is carried to the line that decides whether it is wanted and dropped
  # either way — a Title with no label above it is not an entry.
  printf '%s\n' "$listing" | awk '
    /^\* Label: / {
      label = $0
      sub(/^\* Label: */, "", label)
      sub(/[ \t]+$/, "", label)
      next
    }
    label != "" && /Title: .*Version: / {
      details = $0
      entry = label
      label = ""

      if (details ~ /Action: /) next

      title = details
      sub(/^.*Title: */, "", title)
      sub(/ *,.*$/, "", title)
      if (title ~ /^macOS/) next

      version = details
      sub(/^.*Version: */, "", version)
      sub(/ *,.*$/, "", version)

      print entry "\t" title "\t" version
    }
  '
}

# Apple's own updates, the half of them a Mac with nobody at it can take: whatever
# apple_installable answers with, in one --install and with no --restart.
#
# What went in is read back off a second listing rather than taken from the exit
# status, which `softwareupdate --install` leaves at zero having printed that it
# could not find a label. One `installed:` line per update on stdout, its title and
# its version either side of a comma the way softwareupdate prints them, and
# softwareupdate's own progress on stderr, so that what a caller parses is the lines
# this wrote.
install_apple_updates() {
  local waiting left tab index=0 installed=0 still=""
  local label title version
  local labels=() titles=()

  if [ "$dry_run" = true ]; then
    echo "dry run: would install every Apple update that is waiting, needs no" \
         "restart and is not macOS itself"
    return 0
  fi

  require_root "install-apple-updates"
  log_action install-apple-updates

  if ! waiting="$(apple_installable)"; then
    echo "claude-root: softwareupdate would not say what is waiting, so nothing" >&2
    echo "was installed." >&2
    return 69
  fi

  tab="$(printf '\t')"

  # Read in this shell rather than down a pipe, a label carrying spaces being why
  # the two come back as arrays at all.
  while IFS="$tab" read -r label title version; do
    [ -n "$label" ] || continue
    labels[${#labels[@]}]="$label"
    titles[${#titles[@]}]="$title, $version"
  done < <(printf '%s\n' "$waiting")

  if [ ${#labels[@]} -eq 0 ]; then
    echo "nothing to install: every Apple update waiting either restarts the Mac" \
         "or is macOS itself"
    return 0
  fi

  bounded "$apple_install_seconds" softwareupdate --install "${labels[@]}" >&2

  if ! left="$(apple_installable)"; then
    echo "claude-root: softwareupdate would not say what is left, so what the" >&2
    echo "install put in is unknown." >&2
    return 69
  fi

  while [ "$index" -lt ${#labels[@]} ]; do
    if printf '%s\n' "$left" | grep -qF -- "${labels[$index]}$tab"; then
      still="$still; ${titles[$index]}"
    else
      echo "installed: ${titles[$index]}"
      installed=$((installed + 1))
    fi
    index=$((index + 1))
  done

  if [ "$installed" -eq 0 ]; then
    echo "claude-root: softwareupdate installed none of them. Still waiting:${still#;}" >&2
    return 69
  fi

  if [ -n "$still" ]; then
    echo "claude-root: still waiting after the install:${still#;}" >&2
  fi

  return 0
}

# `--` is the caller's way of saying the rest is arguments. Nothing here takes a
# name that could start with a dash, so it changes no outcome — but a helper that
# treated `--` as an action of its own would refuse for the wrong reason.
if [ "${1:-}" = -- ]; then
  shift
fi

[ $# -gt 0 ] || refuse "no action given"

action="$1"
shift

# Every argument count is checked before anything privileged runs, and so is the
# daemon name inside restart_daemon — which is why a dry run is not a way past any
# of it: dry run only reaches the point where an action would act.
case "$action" in
  --list | list)
    [ $# -eq 0 ] || refuse "--list takes no argument"
    list
    ;;
  restart-daemon)
    [ $# -eq 1 ] || refuse "restart-daemon takes exactly one daemon name"
    restart_daemon "$1"
    ;;
  flush-dns)
    [ $# -eq 0 ] || refuse "flush-dns takes no argument"
    flush_dns
    ;;
  reinstall-portless)
    [ $# -eq 0 ] || refuse "reinstall-portless takes no argument"
    reinstall_portless
    ;;
  install-apple-updates)
    [ $# -eq 0 ] || refuse "install-apple-updates takes no argument"
    install_apple_updates
    ;;
  *)
    refuse "not an allowed action: $action"
    ;;
esac
