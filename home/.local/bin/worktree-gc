#!/usr/bin/env bash
# Sweeps what a finished session leaves behind: a removed worktree's compose
# project and the processes still sitting in its folder, the scratch folder of a
# session nobody is running any more, and the worktree entries git keeps for
# folders that are gone.
#
#   worktree-gc             # sweep
#   worktree-gc --dry-run   # say what a sweep would do, and change nothing
#
# A garbage collector rather than a hook on the removal, because no removal
# reliably hands us one. herdr removes a worktree, so does Claude Code, so does
# `git worktree remove` by hand, and git has no post-remove hook at all;
# Claude Code's WorktreeRemove does not fire for a git worktree
# (anthropics/claude-code#94212), and both it and WorktreeCreate replace Claude
# Code's own git behaviour rather than adding to it, so registering one to clean
# up would mean owning worktree creation. The trigger is therefore time, which
# is what the LaunchAgent is for.
#
# Conservative by construction: a compose project whose folder still exists is
# somebody's session, and so is a process whose cwd still exists, a scratch
# folder a live session claims, and a worktree git still finds on disk. Only the
# gone ones are swept, and only inside the roots this machine makes them in.

set -uo pipefail

dry_run=false

for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=true ;;
    -h | --help)
      echo "usage: worktree-gc [--dry-run]"
      exit 0
      ;;
    *)
      echo "worktree-gc: unknown option $arg" >&2
      exit 2
      ;;
  esac
done

herdr_root="$HOME/.herdr/worktrees"
scratch_root="${CLAUDE_CODE_TMPDIR:-$HOME/.cache/claude-tmp}/claude-$(id -u)"
projects_root="${WORKTREE_GC_PROJECTS:-$HOME/projects}"

# Only ever one line of output per thing done, and nothing at all on a quiet
# sweep: this runs every ten minutes forever, into a log somebody reads only
# when something is wrong.
say() { printf '%s worktree-gc: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1"; }

# mkdir rather than flock, which macOS does not have. A lock left by a killed run
# would otherwise stop every sweep after it, so one older than the ten-minute
# interval the LaunchAgent runs on is taken over.
cache="${XDG_CACHE_HOME:-$HOME/.cache}"
[ -d "$HOME/Library/Caches" ] && cache="$HOME/Library/Caches"
lock="$cache/worktree-gc.lock"

mkdir -p "$cache"

if ! mkdir "$lock" 2>/dev/null; then
  if [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
    say "taking over a lock left behind by $(cat "$lock/pid" 2>/dev/null || echo "an earlier run")"
    rm -rf "$lock"
    mkdir "$lock" 2>/dev/null || exit 0
  else
    exit 0
  fi
fi

echo $$ > "$lock/pid"

# Only ever this run's own lock: a run whose lock was taken over above is still
# going, and removing the directory on its way out would leave the run that took
# it over unlocked.
release_lock() {
  [ "$(cat "$lock/pid" 2>/dev/null)" = "$$" ] && rm -rf "$lock"
}

trap release_lock EXIT

# The worktree folder a path belongs to, or nothing at all for a path outside
# both roots. herdr nests a worktree one level deeper than Claude Code, which
# puts its own inside the repository it branched from.
worktree_of() {
  local path="$1" rest repo branch prefix name

  case "$path" in
    "$herdr_root"/*/*)
      rest="${path#"$herdr_root"/}"
      repo="${rest%%/*}"
      rest="${rest#*/}"
      branch="${rest%%/*}"
      printf '%s/%s/%s\n' "$herdr_root" "$repo" "$branch"
      ;;
    */.claude/worktrees/*)
      prefix="${path%%/.claude/worktrees/*}"
      rest="${path#*/.claude/worktrees/}"
      name="${rest%%/*}"
      printf '%s/.claude/worktrees/%s\n' "$prefix" "$name"
      ;;
    *) return 1 ;;
  esac
}

# Compose projects whose worktree is gone. The project's own labels rather than
# `docker compose ls`, which reports the config files alone: a project started
# from a file passed with -f, or named something compose does not look for, has a
# working_dir and no config file this would recognise. config_files is the second
# opinion — a project keeping any of them is one whose worktree is still there.
#
# Inside a worktree root and nowhere else, which is not the same as a working_dir
# that does not exist: a daemon shared with another machine, or a compose run from
# inside a container, leaves projects whose folder was never on this disk at all,
# and `down -v` on one of those deletes somebody's database over a path that only
# looks missing.
sweep_compose() {
  local project working_dir config_files config alive worktree

  command -v docker >/dev/null 2>&1 || return 0
  docker info >/dev/null 2>&1 || return 0

  docker ps --all --filter label=com.docker.compose.project \
    --format '{{.Label "com.docker.compose.project"}}	{{.Label "com.docker.compose.project.working_dir"}}	{{.Label "com.docker.compose.project.config_files"}}' 2>/dev/null |
    sort -u |
    while IFS=$'\t' read -r project working_dir config_files; do
      [ -n "$project" ] || continue
      [ -n "$working_dir" ] || continue
      [ -d "$working_dir" ] && continue
      worktree="$(worktree_of "$working_dir")" || continue
      [ -d "$worktree" ] && continue

      alive=false
      while IFS= read -r config; do
        [ -n "$config" ] && [ -e "$config" ] && alive=true
      done < <(printf '%s\n' "$config_files" | tr ',' '\n')
      [ "$alive" = true ] && continue

      if [ "$dry_run" = true ]; then
        say "would remove compose project $project, whose worktree $worktree is gone"
        continue
      fi

      say "removing compose project $project, whose worktree $worktree is gone"
      docker compose -p "$project" down -v --remove-orphans 2>&1 |
        sed 's/^/  /'
    done
}

# Everything between this process and pid 1, so a sweep cannot kill the shell,
# the agent or launchd that started it.
own_tree() {
  local pid=$$ ppid

  while [ -n "$pid" ] && [ "$pid" != 0 ] && [ "$pid" != 1 ]; do
    printf '%s\n' "$pid"
    ppid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d '[:space:]')"
    [ "$ppid" = "$pid" ] && break
    pid="$ppid"
  done
}

# pid and cwd per process. /proc where there is one, which also marks a removed
# directory with a " (deleted)" suffix; lsof on the Mac, in one pass rather than
# one per pid.
process_cwds() {
  local link pid target

  if [ -d /proc ]; then
    for link in /proc/[0-9]*/cwd; do
      pid="${link#/proc/}"
      pid="${pid%/cwd}"
      target="$(readlink "$link" 2>/dev/null)" || continue
      [ -n "$target" ] || continue
      printf '%s\t%s\n' "$pid" "${target% (deleted)}"
    done
  else
    lsof -a -d cwd -Fpn 2>/dev/null |
      awk '/^p/ { pid = substr($0, 2); next }
           /^n/ { if (pid != "") printf "%s\t%s\n", pid, substr($0, 2) }'
  fi
}

# A process whose cwd no longer exists, inside a worktree that no longer exists.
# Both halves matter: a cwd that is still there belongs to a session that is
# still working, and a removed subdirectory of a worktree that survived is the
# project's business rather than this script's.
sweep_processes() {
  local mine victims=() pid cwd worktree

  mine="$(own_tree | tr '\n' ' ')"

  while IFS=$'\t' read -r pid cwd; do
    [ -n "$pid" ] && [ "$pid" != 1 ] || continue
    case " $mine " in *" $pid "*) continue ;; esac
    [ -n "$cwd" ] || continue
    [ -d "$cwd" ] && continue

    if ! worktree="$(worktree_of "$cwd")"; then
      # Outside both roots, so not this script's to kill. Said out loud anyway:
      # a removed worktree somewhere else is exactly the thing a sweep is for.
      case "$cwd" in
        */worktrees/*) say "left alone: $pid sits in $cwd, outside the worktree roots" ;;
      esac
      continue
    fi

    [ -d "$worktree" ] && continue

    if [ "$dry_run" = true ]; then
      say "would kill $pid ($(ps -o comm= -p "$pid" 2>/dev/null | tr -d '[:space:]')), left in the removed $worktree"
    else
      say "killing $pid ($(ps -o comm= -p "$pid" 2>/dev/null | tr -d '[:space:]')), left in the removed $worktree"
      victims+=("$pid")
    fi
  done < <(process_cwds)

  [ ${#victims[@]} -gt 0 ] || return 0

  kill -TERM "${victims[@]}" 2>/dev/null

  # A dev server closing sockets and a database flushing both want a moment; what
  # is still there after it was not going to leave.
  local waited=0
  while [ "$waited" -lt 10 ]; do
    local remaining=()
    for pid in "${victims[@]}"; do
      kill -0 "$pid" 2>/dev/null && remaining+=("$pid")
    done
    [ ${#remaining[@]} -gt 0 ] || return 0
    sleep 1
    waited=$((waited + 1))
  done

  for pid in "${victims[@]}"; do
    if kill -0 "$pid" 2>/dev/null; then
      say "$pid ignored SIGTERM, sending SIGKILL"
      kill -KILL "$pid" 2>/dev/null
    fi
  done
}

is_uuid() {
  printf '%s\n' "$1" |
    grep -qE '^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$'
}

# The session ids of every Claude Code process still running. The record outlives
# the process it describes, so the pid in the filename is what decides, and the
# id comes out with sed because jq is not something this may depend on.
live_session_ids() {
  local record pid id

  for record in "$HOME/.claude/sessions"/*.json; do
    [ -f "$record" ] || continue
    pid="${record##*/}"
    pid="${pid%.json}"
    case "$pid" in '' | *[!0-9]*) continue ;; esac
    kill -0 "$pid" 2>/dev/null || continue
    id="$(sed -n 's/.*"sessionId"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      "$record" | head -n 1)"
    [ -n "$id" ] && printf '%s\n' "$id"
  done
}

# Session scratch folders, one per session under a folder per project. Only a
# directory named like a session id is ever removed: `bash-edit-diff`, `tasks`
# and whatever else Claude Code keeps beside them belong to no session, and the
# folders a level up — cc-socks, tart — belong to no project.
#
# A week of grace on top of the session being over, because `claude --resume`
# reuses the folder, and herdr resumes every session it had after a restart. The
# project folder goes only when the last session in it did, and with rmdir, so
# anything left makes it stay.
sweep_scratch() {
  local live slug session name kept

  [ -d "$scratch_root" ] || return 0

  live=" $(live_session_ids | tr '\n' ' ')"

  for slug in "$scratch_root"/*; do
    [ -d "$slug" ] || continue

    kept=0
    for session in "$slug"/*; do
      [ -e "$session" ] || continue
      name="${session##*/}"

      if [ ! -d "$session" ] || ! is_uuid "$name"; then
        kept=$((kept + 1))
        continue
      fi

      case "$live" in
        *" $name "*)
          kept=$((kept + 1))
          continue
          ;;
      esac

      if [ -n "$(find "$session" -mtime -7 -print -quit 2>/dev/null)" ]; then
        kept=$((kept + 1))
        continue
      fi

      if [ "$dry_run" = true ]; then
        say "would remove scratch folder $session, whose session is over"
        continue
      fi

      say "removing scratch folder $session, whose session is over"
      rm -rf "$session"
    done

    # A .DS_Store Finder left behind keeps the folder too, which is what rmdir
    # would do with it anyway.
    for session in "$slug"/.*; do
      case "${session##*/}" in . | ..) continue ;; esac
      [ -e "$session" ] && kept=$((kept + 1))
    done

    [ "$kept" -eq 0 ] || continue

    if [ "$dry_run" = true ]; then
      say "would remove the empty project folder $slug"
      continue
    fi

    rmdir "$slug" 2>/dev/null && say "removed the empty project folder $slug"
  done
}

# The worktree entries git keeps for folders that are gone. Its own prune rather
# than a rule of ours: it drops metadata only, and only for a worktree whose
# folder git cannot find, so a session still working keeps its entry. Nothing
# outside ~/projects, where this machine's repositories are, and a .git directory
# rather than a file, which is what a worktree itself has.
sweep_worktree_entries() {
  local repo line entry reason flags="" verb="pruning"

  [ -d "$projects_root" ] || return 0
  command -v git >/dev/null 2>&1 || return 0

  if [ "$dry_run" = true ]; then
    flags=--dry-run
    verb="would prune"
  fi

  for repo in "$projects_root"/*; do
    [ -d "$repo/.git" ] || continue

    # git reports what it pruned on stderr, hence the whole of its output and the
    # filter on the lines that name an entry.
    while IFS= read -r line; do
      case "$line" in "Removing "*) ;; *) continue ;; esac
      entry="${line#Removing }"
      reason="${entry#*: }"
      entry="${entry%%:*}"
      say "$verb $repo's worktree entry $entry, whose folder is gone ($reason)"
    done < <(git -C "$repo" worktree prune -v $flags 2>&1)
  done
}

sweep_compose
sweep_processes
sweep_scratch
sweep_worktree_entries

if [ "$dry_run" = true ]; then
  say "dry run over"
fi
