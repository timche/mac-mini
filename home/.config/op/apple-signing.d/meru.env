# Added by with-apple-signing to a build whose origin remote is meru, on top of
# apple-signing.env.
#
# The provisioning profile authorizes the keychain-access-groups entitlement Touch
# ID unlock uses, and a signed build without it fails to decode a file that is not
# there. The name is the one meru's release workflow gives the same base64, and the
# wrapper writes it to the path meru's electron-builder config names. Not a secret,
# since every signed Meru.app carries a copy, but it sits beside the rest of the
# signing material in 1Password.
APPLE_PROVISIONING_PROFILE="op://Meru/Apple Provisioning Profile/base64"
