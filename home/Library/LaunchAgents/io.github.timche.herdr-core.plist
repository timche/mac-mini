<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- A herdr-core core up at login, started from inside the logged-in GUI session.
     Every Claude Code session is a terminal of one core, and where that core was
     started decides what its terminals are: started here, a terminal is a local
     Aqua one, where a core a remote client started over SSH first leaves every
     terminal in macOS's Background security session (herdrdev/herdr-core#104).
     Terminals' privacy grants are Herdr Core.app's — each holder makes itself the
     responsible process — so this job answers for nothing and needs no identity of
     its own. Linked like the agents beside it, and for the same reason it names no
     path launchd would have to expand.

     Run at load and nothing more, because herdr-core starts a core on demand and a
     start against a running one changes nothing. Two gaps are herdr-core's to close
     rather than this job's: a core that crashes is replaced by whichever `hc` caller
     comes next, carrying that caller's environment into new terminals
     (herdr-core#86), and a core a client started before login keeps the Background
     session until something restarts it. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.timche.herdr-core</string>
  <!-- `hc run` starts a program directly rather than through a login shell, so
       what it inherits from the core is the whole of its PATH — the shims and
       ~/.local/bin ahead of Homebrew, as .zshenv orders them. A UTF-8 locale
       launchd does not hand a job, and exec because nothing has to outlive the
       start. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"; export LANG=en_US.UTF-8; exec "$HOME/.local/bin/hc" server start >>"$HOME/Library/Logs/herdr-core.log" 2>&amp;1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- No KeepAlive: `hc server start` returns as soon as a core is up, which launchd
       would read as a job to start again. -->
  <!-- Terminals run builds, dev servers and agents; launchd would otherwise
       throttle them as background work. -->
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
