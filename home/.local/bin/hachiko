#!/bin/sh
# Runs hachiko, the watch over free space and the CPU, and builds it first if its sources
# have changed since the binary in the cache was made. Why the Go tools here are built on
# the way past at all is in the shared script this ends by sourcing.
#
# What is hachiko's own: the secrets its alerts are sent with, which are a reference in its
# folder rather than anything this resolves, and that a Mac with no hachiko binary is a Mac
# with nothing watching it — which is the one thing a failed build here cannot be quiet
# about.

set -u

tool=hachiko
cache=${HACHIKO_CACHE_DIR:-}
no_binary="there is no hachiko binary and none could be built, so nothing is watching this Mac"

# The repository is found through this script's own resolved path rather than named, so the
# same wrapper works as the symlink in ~/.local/bin, as a file in a checkout, and in a
# worktree.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
self=$(cd "$(dirname "$self")" && pwd)/$(basename "$self")
repo=$(cd "$(dirname "$self")/../../.." && pwd)

# In hachiko's own folder, which is where mise links it beside the config, so the alert has
# somewhere to go without the binary in the cache knowing where the checkout is.
HACHIKO_ENV_FILE="${HACHIKO_ENV_FILE:-$HOME/.hachiko/hachiko.env.op}"
export HACHIKO_ENV_FILE

. "$repo/home/.local/libexec/build-tool"
