<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Symlinked into ~/Library/LaunchAgents by claude/ssh-agent.sh, which launchd
     accepts: it resolves the link at bootstrap and reads the file behind it.

     There is nothing to render because there is no absolute path here. launchd
     expands neither ~ nor $HOME in a plist — a $HOME in StandardOutPath is an
     EX_CONFIG failure at load, with nothing anywhere saying which key was wrong —
     but it does hand a gui-domain agent a HOME, so a shell is all it takes to
     expand one. Everything else the wrapper derives from the same $HOME, including
     the log, which is why this names no log file. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.timche.ssh-agent</string>
  <!-- ~/.ssh/agent.sh is itself a link to launchd/agent.sh in the checkout, which
       is what lets this path be both fixed and wherever MAC_MINI_DIR put it. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.ssh/agent.sh"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Unconditional, unlike boswell's: this job is never meant to be finished
       with, and a restart is also how the key is re-read after the token or the
       network came back. bootout is the only thing that stops it. -->
  <key>KeepAlive</key>
  <true/>
  <!-- Long enough that a Mac booting without a network retries at the same pace
       the agent itself does rather than spinning. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
